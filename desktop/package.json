{
  "name": "ken-desktop",
  "version": "1.0.0",
  "description": "KEN — personal AI assistant desktop app (connects to your KEN server; uses the owner's API key)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.janak.ken",
    "productName": "KEN",
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "ken-config.json",
        "to": "ken-config.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
